{
  "name": "pit-crew",
  "version": "0.1.0",
  "description": "A CLI for safe Git workflows",
  "type": "module",
  "bin": {
    "pit": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.js && chmod +x dist/cli.js",
    "test": "vitest run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  }
}
